# yt-dlp configuration file # Output directory and filename format # This will save files to ~/ugh_dren/Artist/Album/Title.ext # It also includes the upload date in the filename for better organization. -o ~/ugh_dren/%(artist,uploader)s/%(album,playlist)s/%(upload_date>%Y-%m-%d)s - %(title)s.%(ext)s # Embed all available metadata --embed-metadata # Embed chapters if available --embed-chapters # Embed thumbnail as cover art --embed-thumbnail # Write all metadata to a JSON file --write-info-json # Write description to a .description file --write-description # Write subtitles to a .vtt file --write-subs --all-subs # Write annotations to a .annotations file --write-annotations # Keep original files after post-processing (e.g., embedding metadata) --keep-video # Download best available video and audio -f bestvideo+bestaudio/best # Convert to mp4 if not already --recode-video mp4 # Post-processor arguments for embedding metadata # This ensures that the metadata is properly embedded into the file. --ppa "EmbedThumbnail+ffmpeg_o:-c:v copy -c:a copy" 